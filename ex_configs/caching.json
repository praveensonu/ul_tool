        "skip_test": true,
        "skip_influence": true,
        "grads_path": "outputs/gradients/example/training"
    },
    "model": {
        "model_path": "meta-llama/Llama-3.2-1B-Instruct",
        "max_length": 512,
        "load_in_4bit": false,
        "lora_path": null

    },
    "postprocess": {
        "enable": false
    }
}
